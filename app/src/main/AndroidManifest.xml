<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Menambahkan izin untuk akses internet, membaca kontak, kamera, dan penyimpanan eksternal -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" /> <!-- Menentukan bahwa aplikasi ini membutuhkan fitur hardware kamera -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <uses-feature
        android:name="android.hardware.camera"
        android:required="true" />

    <application
        android:name="com.colab.myfriend.App"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyFriend"
        tools:targetApi="31">
        <activity
            android:name="com.colab.myfriend.activity.PushNotificationActivity"
            android:exported="false" />

        <activity
            android:name="com.colab.myfriend.activity.WorkManagerActivity"
            android:exported="false" />

        <activity
            android:name="com.colab.myfriend.activity.MapsActivity2"
            android:exported="false" />

        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="AIzaSyCpp8NnVzwQ8mWT2Z0_X_2VvZkzQ4psDFM" />

        <activity
            android:name="com.colab.myfriend.activity.LoginActivity"
            android:exported="true">
            <intent-filter>

                <!-- Intent filter yang menandakan aktivitas ini sebagai MAIN (aktivitas pertama kali dijalankan) -->
                <action android:name="android.intent.action.MAIN" />
                <!-- Kategori LAUNCHER agar aplikasi dapat muncul di daftar aplikasi pada launcher perangkat -->
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity> <!-- Deklarasi aktivitas EditFriendActivity dengan mode input soft-keyboard "adjustPan" -->
        <activity
            android:name="com.colab.myfriend.activity.MenuHomeActivity"
            android:exported="true" /> <!-- Deklarasi aktivitas DetailFriendActivity yang dapat diakses dari luar aplikasi -->
        <activity
            android:name="com.colab.myfriend.activity.DetailProductActivity"
            android:exported="true" />
        <activity
            android:name="com.colab.myfriend.activity.MainActivity"
            android:exported="true" />
        <activity
            android:name="com.colab.myfriend.activity.TrialSettingActivity"
            android:exported="true" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.colab.myfriend.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_provider" />
        </provider>

        <service
            android:name="com.colab.myfriend.worker.FirebaseMsgService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

    </application>

</manifest>